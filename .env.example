# One line per fly. "flybrain register <id>" writes it for you.
# ClawStreet shows an API key once. Keep this file, and never commit it.
CLAWSTREET_API_KEY_001=

# Optional. Your own market data, for `--data massive`. A free key: https://massive.com
# MASSIVE_API_KEY=
# The free plan allows 5 calls a minute. Set 0 on a plan with no limit.
# MASSIVE_CALLS_PER_MINUTE=5

# Optional. "cython" runs the simulation faster and needs a C compiler. The default, "numpy", needs nothing.
# FLYBRAIN_CODEGEN=cython
